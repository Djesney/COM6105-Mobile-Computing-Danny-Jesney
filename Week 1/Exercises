// Exercise 7

fun add(a: Int, b: Int): Int {
    return a + b
}

fun largest(a: Int, b: Int): Int {
    return if (a > b) a else b
}

fun rectangleArea(length: Double, width: Double): Double {
    return length * width
}

fun celsiusToFahrenheit(celsius: Double): Double {
    return (celsius * 9/5) + 32
}

fun main() {
    
    println("Add: ${add(10, 20)}")
    
    println("Largest: ${largest(15, 25)}")
    
    println("Rectangle area: ${rectangleArea(10.0, 5.0)}")
    
    println("Fahrenheit: ${celsiusToFahrenheit(20.0)}")
    
}

